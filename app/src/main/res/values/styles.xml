<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVAccessibilityManager" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TvButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minWidth">132dp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TvButton.Primary" parent="TvButton">
        <item name="android:background">@drawable/button_primary_background</item>
    </style>
</resources>
