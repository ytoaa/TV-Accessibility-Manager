<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#397ACC" />
            <corners android:radius="8dp" />
            <stroke android:width="3dp" android:color="@color/focus" />
            <padding android:left="18dp" android:top="8dp" android:right="18dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#245A9A" />
            <corners android:radius="8dp" />
            <padding android:left="18dp" android:top="8dp" android:right="18dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
